    (uuid 9eb6323b-5e85-486b-8ae9-199ce5e765a1)
  )
  (text "ROMSEL_EXP = ROMSEL_N OR RW_SYN   (J11 pin44; game mode: = ROMSEL_N)" (at 620.0 308.0 0)
